          "stringUnit": {
            "state": "translated",
            "value": "Make the most of your morning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晨时光贵如金"
          }
        }
      }
    },
    "wake.introTitle": {
      "localizations": {
