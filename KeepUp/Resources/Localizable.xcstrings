    "theme.description.0" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep in the universe is a banana planet, home to the people who love checking in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在宇宙深处中有一颗香蕉星球，那里的居民叫做打卡星人"
          }
        }
      }
    },
    "theme.description.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunrise over Tiananmen. Welcome to Beijing, the capital."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我爱北京天安门，天安门上太阳升\n你好，这里是帝都"
          }
        }
      }
    },
    "theme.description.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red roofs, green trees, blue skies and sea: a home for sailing and the aroma of beer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红瓦绿树，碧海蓝天，啤酒飘香，帆的故乡"
          }
        }
      }
    },
    "theme.description.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The river flows on through a city whose international spirit is steeped in romance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浪奔，浪流，万里滔滔江水永不休...... \n这个国际化大都市的骨子里沉淀着浪漫的味道"
          }
        }
      }
    },
    "theme.description.4" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A city of hot dry noodles and spicy duck necks. Make mine a generous helping!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "神奇的热干面之都啊，请给我来一打鸭脖"
          }
        }
      }
    },
    "theme.description.5" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scooters weave through Taipei, carrying the youthful energy of Taiwanese cinema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在台湾电影里，永远少不了机车的身影，多少的青春悸动从这里发酵"
          }
        }
      }
    },
    "theme.description.6" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Guangzhou, everyone has a friendly title: handsome, beautiful, or boss."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一座让人迷失自我的城市，青年人在这里都是靓仔靓女，中年人在这里都是老板"
          }
        }
      }
    },
    "theme.description.7" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mountain city by the rivers, where winter belongs to hotpot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界上最大的内陆山水之城，这里的冬天是属于火锅的"
          }
        }
      }
    },
    "theme.description.8" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A place devoted to love. Lugu Lake is said to be the goddess Gemu’s last teardrop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个爱情至上的地方，泸沽湖是格姆女神的最后一滴眼泪"
          }
        }
      }
    },
    "theme.description.9" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find a moment of peace in this haven on the roof of the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界屋脊上的另一片乐土，在这里彻底地放空一次吧"
          }
        }
      }
    },
    "theme.description.10" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jewel on the Silk Road, far from the world’s oceans."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乌鲁木齐是丝绸之路上的璀璨明珠，也是世界上离海洋最远的城市"
          }
        }
      }
    },
    "theme.description.11" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discover a mirror of the sky at Chaka Salt Lake, beyond Xining."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不必去玻利维亚，在茶卡盐湖，就可以见到中国的「天空之境」"
          }
        }
      }
    },
    "theme.description.12" : {
      "extractionState" : "stale",
