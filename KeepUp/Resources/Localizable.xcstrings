    "wake.rule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in from 5:00 to before 9:00 to count as an early rise. The actual check-in time is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5:00～9:00内打卡算为早起，以实际打卡时间为准。"
          }
        }
      }
    },
